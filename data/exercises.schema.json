{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhouxishun1993-code/keyoudu-exercise-dataset/blob/main/data/exercises.schema.json",
  "title": "Keyoudu Exercise Dataset",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_version",
    "generated_at",
    "language",
    "counts",
    "source",
    "licenses",
    "notice",
    "exercises"
  ],
  "properties": {
    "schema_version": {
      "const": "1.2.0"
    },
    "dataset_version": {
      "type": "string",
      "pattern": "^[0-9]+.[0-9]+.[0-9]+(-[0-9A-Za-z.]+)?$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "language": {
      "const": "zh-CN"
    },
    "counts": {
      "type": "object",
      "required": [
        "exercises",
        "media_files",
        "professional_reviewed"
      ],
      "properties": {
        "exercises": {
          "type": "integer",
          "minimum": 1
        },
        "media_files": {
          "type": "integer",
          "minimum": 1
        },
        "professional_reviewed": {
          "const": 0
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object"
    },
    "licenses": {
      "type": "object"
    },
    "notice": {
      "type": "string"
    },
    "exercises": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/exercise"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "exercise": {
      "type": "object",
      "required": [
        "id",
        "name_zh",
        "aliases",
        "body_part",
        "equipment",
        "target",
        "target_zh",
        "measurement",
        "instructions_zh",
        "instructions_en",
        "source",
        "media",
        "review"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ex-[0-9]{4}$"
        },
        "name_zh": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "body_part": {
          "description": "Chinese body-region label; one value per upstream body_part bucket.",
          "enum": [
            "背部",
            "胸部",
            "肩部",
            "上臂",
            "前臂",
            "核心",
            "臀腿",
            "小腿",
            "有氧",
            "颈部"
          ]
        },
        "equipment": {
          "description": "Chinese equipment label.",
          "enum": [
            "自重",
            "哑铃",
            "杠铃",
            "曲杆杠铃",
            "六角杠铃",
            "壶铃",
            "绳索",
            "固定器械",
            "史密斯机",
            "弹力带",
            "拉伸带",
            "负重",
            "瑞士球",
            "BOSU球",
            "药球",
            "泡沫轴",
            "健腹轮",
            "平衡板",
            "战绳",
            "攀爬绳",
            "跳绳",
            "训练锤",
            "轮胎",
            "有氧器械",
            "搭档辅助"
          ]
        },
        "target": {
          "description": "Primary target, kept as the upstream English key for stable programmatic use.",
          "enum": [
            "abs",
            "abductors",
            "adductors",
            "biceps",
            "calves",
            "cardiovascular system",
            "delts",
            "forearms",
            "glutes",
            "hamstrings",
            "lats",
            "levator scapulae",
            "pectorals",
            "quads",
            "serratus anterior",
            "spine",
            "traps",
            "triceps",
            "upper back"
          ]
        },
        "target_zh": {
          "description": "Chinese label for target.",
          "enum": [
            "腹肌",
            "髋外展肌群",
            "髋内收肌群",
            "肱二头肌",
            "小腿肌群",
            "心肺系统",
            "三角肌",
            "前臂肌群",
            "臀肌",
            "腘绳肌",
            "背阔肌",
            "肩胛提肌",
            "胸肌",
            "股四头肌",
            "前锯肌",
            "竖脊肌",
            "斜方肌",
            "肱三头肌",
            "上背部"
          ]
        },
        "measurement": {
          "enum": [
            "reps",
            "duration"
          ]
        },
        "instructions_zh": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 4
          }
        },
        "instructions_en": {
          "description": "English rendering of instructions_zh, one item per Chinese step.",
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 4
          }
        },
        "source": {
          "type": "object",
          "required": [
            "id",
            "name",
            "commit",
            "url",
            "text_license"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9]{4}$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "commit": {
              "const": "7455efae41b330c265e7cd4b78dfa848e7ce5ebd"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "text_license": {
              "const": "MIT"
            }
          },
          "additionalProperties": false
        },
        "media": {
          "type": "object",
          "required": [
            "thumbnail",
            "start",
            "end",
            "format",
            "attribution",
            "license",
            "ai_generated",
            "sha256",
            "dimensions",
            "frames",
            "sequence"
          ],
          "properties": {
            "thumbnail": {
              "type": "string",
              "pattern": "^images/ex-[0-9]{4}-thumb\\.webp$"
            },
            "start": {
              "type": "string",
              "pattern": "^images/ex-[0-9]{4}-start\\.webp$"
            },
            "end": {
              "type": "string",
              "pattern": "^images/ex-[0-9]{4}-end\\.webp$"
            },
            "format": {
              "const": "webp"
            },
            "attribution": {
              "const": "课有度 Keyoudu"
            },
            "license": {
              "const": "CC BY 4.0"
            },
            "ai_generated": {
              "const": true
            },
            "sha256": {
              "type": "object",
              "required": [
                "thumbnail",
                "start",
                "end"
              ],
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "dimensions": {
              "type": "object",
              "required": [
                "thumbnail",
                "start",
                "end"
              ],
              "additionalProperties": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "integer",
                    "minimum": 1
                  }
                ],
                "items": false
              }
            },
            "frames": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "phase",
                  "path",
                  "sha256",
                  "dimensions"
                ],
                "properties": {
                  "phase": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^images/ex-[0-9]{4}-[a-z][a-z0-9-]*\\.webp$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "dimensions": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 768
                      },
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 768
                      }
                    ],
                    "items": false,
                    "minItems": 2
                  }
                },
                "additionalProperties": false
              }
            },
            "sequence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              }
            }
          },
          "additionalProperties": false
        },
        "review": {
          "type": "object",
          "required": [
            "stage",
            "visual_screening",
            "professional_review"
          ],
          "properties": {
            "stage": {
              "const": "reviewed_illustration"
            },
            "visual_screening": {
              "const": "ai_quick_visual_pass"
            },
            "professional_review": {
              "const": "not_performed"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "description": "Schema for data/exercises.json. Enumerations are closed: adding a body part, equipment or target value requires a schema change."
}
